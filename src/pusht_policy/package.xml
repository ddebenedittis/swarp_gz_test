<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pusht_policy</name>
  <version>0.0.1</version>
  <description>Runs a swarp pusht_lidar policy on robots that sense a LaserScan and world-frame poses.</description>
  <maintainer email="davide@cyber-fusion.io">Davide De Benedittis</maintainer>
  <license>MIT</license>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>limo_bridge</exec_depend>
  <exec_depend>limo_real</exec_depend>
  <exec_depend>pusht_gz</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
