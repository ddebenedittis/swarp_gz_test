Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_1/map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_1/map_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.5
      Update Interval: 0
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Robots, goal T, arena
      Enabled: true
      Namespaces: ~
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /viz/markers
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: robot_1 scan
      Enabled: true
      Alpha: 1
      Color: 230; 50; 50
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (m): 0.03
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot_1/scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: robot_2 scan
      Enabled: true
      Alpha: 1
      Color: 50; 100; 230
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (m): 0.03
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot_2/scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: robot_1 scan_loc (AMCL input)
      Enabled: false
      Alpha: 1
      Color: 255; 170; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot_1/scan_loc
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Name: robot_2 scan_loc (AMCL input)
      Enabled: false
      Alpha: 1
      Color: 0; 200; 220
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot_2/scan_loc
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: robot_1 AMCL pose + covariance
      Enabled: true
      Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.03
      Color: 230; 50; 50
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 0.4
          Scale: 1
          Value: true
        Position:
          Alpha: 0.35
          Color: 230; 50; 50
          Scale: 1
          Value: true
        Value: true
      Head Length: 0.08
      Head Radius: 0.05
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_1/amcl_pose
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: robot_2 AMCL pose + covariance
      Enabled: true
      Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.03
      Color: 50; 100; 230
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 0.4
          Scale: 1
          Value: true
        Position:
          Alpha: 0.35
          Color: 50; 100; 230
          Scale: 1
          Value: true
        Value: true
      Head Length: 0.08
      Head Radius: 0.05
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_2/amcl_pose
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: goal (arrow)
      Enabled: true
      Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.03
      Color: 30; 220; 80
      Head Length: 0.1
      Head Radius: 0.06
      Shaft Length: 0.35
      Shaft Radius: 0.025
      Shape: Arrow
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal
      Value: true
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: goal (drag)
      Enabled: true
      Interactive Markers Namespace: /goal_drag
      Show Axes: false
      Show Descriptions: false
      Show Visual Aids: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 80
      X: 0
      Y: 0
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: true
